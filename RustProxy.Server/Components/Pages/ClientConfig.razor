@page "/client-config"
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime Js
@inject NavigationManager Navigation

<PageTitle>Client config / RustProxy</PageTitle>
<div class="workspace-head"><div><p class="eyebrow">Connect local clients</p><h1>Client configuration</h1><p class="lede">Choose the operating system used by the offline client.</p></div></div>

<section class="platform-picker" aria-label="Operating system">
    <span class="picker-label">Detected platform</span>
    <div class="platform-tabs" role="tablist">
        @foreach (var platform in platforms)
        {
            <button class="platform-tab @(selectedPlatform == platform.Id ? "selected" : "")" role="tab" aria-selected="@(selectedPlatform == platform.Id)" @onclick="() => SelectPlatform(platform.Id)">
                <span class="platform-symbol">@platform.Symbol</span><span>@platform.Name</span>@if (detectedPlatform == platform.Id){<small>detected</small>}
            </button>
        }
    </div>
</section>

<div class="selected-platform-note"><span class="status-dot"></span><span>Showing commands for <strong>@CurrentPlatform.Name</strong>.</span><label>Architecture <select @bind="selectedArchitecture"><option value="x64">x86_64</option><option value="arm64">aarch64 / ARM64</option></select></label><code>@CurrentTarget</code></div>

<section class="config-grid">
    <div class="config-card"><div class="config-card-head"><span class="config-badge cargo-badge">C</span><div><h2>Cargo</h2><p>Configure the local sparse registry for crates.</p></div></div><label>Registry index</label><code class="code-block">sparse+@BaseUri/cargo/index/</code><label>Cargo config</label><pre><code>[source.crates-io]
replace-with = "rustproxy"

[source.rustproxy]
registry = "sparse+@BaseUri/cargo/index/"
</code></pre><p class="config-hint">Save as <code>@CurrentPlatform.CargoConfigPath</code></p></div>
    <div class="config-card"><div class="config-card-head"><span class="config-badge rustup-badge">R</span><div><h2>rustup</h2><p>Install rustup and toolchains from this local mirror.</p></div></div><label>@CurrentPlatform.ShellLabel</label><pre><code>@RustupCommand</code></pre><label>Install a toolchain</label><pre><code>rustup toolchain install stable --component rust-src</code></pre><p class="config-hint">The installer URL and update metadata are served from this mirror.</p></div>
</section>

<div class="config-footnote"><span class="status-dot"></span><span>These commands use the current browser origin. Import the installer for the selected architecture and configure the environment before running rustup-init.</span></div>

@code {
    private readonly IReadOnlyList<PlatformOption> platforms =
    [
        new("linux", "Linux", "⌁", "~/.cargo/config.toml", "Shell", "export RUSTUP_DIST_SERVER=\"{0}\"\nexport RUSTUP_UPDATE_ROOT=\"{0}/rustup\"\ncurl -fSL \"{0}/rustup/dist/{1}/rustup-init\" -o rustup-init\nchmod +x rustup-init\n./rustup-init"),
        new("macos", "macOS", "⌘", "~/.cargo/config.toml", "Terminal", "export RUSTUP_DIST_SERVER=\"{0}\"\nexport RUSTUP_UPDATE_ROOT=\"{0}/rustup\"\ncurl -fSL \"{0}/rustup/dist/{1}/rustup-init\" -o rustup-init\nchmod +x rustup-init\n./rustup-init"),
        new("windows", "Windows", "⊞", "%USERPROFILE%\\.cargo\\config.toml", "PowerShell", "$env:RUSTUP_DIST_SERVER = \"{0}\"\n$env:RUSTUP_UPDATE_ROOT = \"{0}/rustup\"\nInvoke-WebRequest \"{0}/rustup/dist/{1}/rustup-init.exe\" -OutFile rustup-init.exe\n.\\rustup-init.exe")
    ];
    private string selectedPlatform = "linux";
    private string selectedArchitecture = "x64";
    private string? detectedPlatform;
    private IJSObjectReference? module;
    private string BaseUri => Navigation.BaseUri.TrimEnd('/');
    private PlatformOption CurrentPlatform => platforms.First(platform => platform.Id == selectedPlatform);
    private string CurrentTarget => (selectedArchitecture == "arm64" ? "aarch64" : "x86_64") + (selectedPlatform switch { "windows" => "-pc-windows-msvc", "macos" => "-apple-darwin", _ => "-unknown-linux-gnu" });
    private string RustupCommand => string.Format(CurrentPlatform.RustupTemplate, BaseUri, CurrentTarget);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            module = await Js.InvokeAsync<IJSObjectReference>("import", "./platform-detector.js");
            detectedPlatform = await module.InvokeAsync<string>("detectPlatform");
            selectedPlatform = platforms.Any(platform => platform.Id == detectedPlatform) ? detectedPlatform : "linux";
            selectedArchitecture = selectedPlatform == "macos" ? "arm64" : "x64";
            StateHasChanged();
        }
        catch (JSException)
        {
            detectedPlatform = null;
        }
    }

    private void SelectPlatform(string platform) => selectedPlatform = platform;
    public async ValueTask DisposeAsync() { if (module is not null) await module.DisposeAsync(); }

    private sealed record PlatformOption(string Id, string Name, string Symbol, string CargoConfigPath, string ShellLabel, string RustupTemplate);
}
