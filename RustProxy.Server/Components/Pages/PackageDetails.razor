@page "/packages/{Id:long}"
@using RustProxy.Core.Package
@inject RustProxy.Server.Services.PackageCatalog Catalog

<PageTitle>Package @Id / RustProxy</PageTitle>
@if (package is null){<div class="empty-state"><h1>Source not found</h1><p>The requested source is not in this registry.</p><a href="/">Back to sources</a></div>}
else
{
    <div class="breadcrumbs"><a href="/">Sources</a><span>/</span><span>Package @Id</span></div>
    <div class="workspace-head detail-head"><div><p class="eyebrow">Imported source content</p><h1>Package @Id</h1><p class="lede">@package.CargoDependencies.Count Cargo dependencies · @package.Toolchains.Count toolchains · @package.Files.Count files</p></div><a class="button button-secondary" href="/packages/@Id/manifest.json">Download manifest</a></div>
    <div class="source-summary"><section class="section-block"><div class="section-heading"><h2>Cargo dependencies</h2><span>@cargoDependencies.Count crates</span></div>@if(cargoDependencies.Count == 0){<p class="section-empty">No Cargo metadata recorded.</p>}else{<div class="dependency-list">@foreach(var dependency in cargoDependencies){<div class="dependency-row"><span class="package-icon">CRG</span><span class="dependency-name">@dependency.Name</span><code>@string.Join(", ", dependency.Versions)</code></div>}</div>}</section><section class="section-block"><div class="section-heading"><h2>Toolchains</h2><span>@package.Toolchains.Count targets</span></div>@foreach(var toolchain in package.Toolchains){<div class="toolchain-row"><span class="config-badge rustup-badge">R</span><span><strong>@toolchain.Version</strong><small>@toolchain.Target</small></span></div>}</section></div>
    <section class="section-block file-section"><div class="section-heading"><h2>Stored source files</h2><span>@package.Files.Count entries</span></div><div class="file-list"><Virtualize Items="package.Files" Context="file" ItemSize="38"><div class="file-row"><span class="file-type">@(file.Path.StartsWith("cargo/") ? "CRG" : "RUP")</span><span class="file-path">@file.Path</span><span class="file-size">@FormatSize(file.Length)</span><code>@file.Sha256[..Math.Min(12, file.Sha256.Length)]…</code></div></Virtualize></div></section>
}
@code {[Parameter] public long Id { get; set; } private PackageManifest? package; private List<CargoDependencyGroup> cargoDependencies => package?.CargoDependencies.GroupBy(item => item.Name, StringComparer.OrdinalIgnoreCase).Select(group => new CargoDependencyGroup(group.Key, group.Select(item => item.Version).Distinct().Order(StringComparer.Ordinal).ToList())).OrderBy(item => item.Name, StringComparer.OrdinalIgnoreCase).ToList() ?? []; private sealed record CargoDependencyGroup(string Name, List<string> Versions); protected override async Task OnParametersSetAsync() => package = await Catalog.FindAsync(Id); private static string FormatSize(long bytes) => bytes switch { < 1024 => $"{bytes} B", < 1024 * 1024 => $"{bytes / 1024d:0.0} KB", _ => $"{bytes / 1024d / 1024d:0.0} MB" };}
