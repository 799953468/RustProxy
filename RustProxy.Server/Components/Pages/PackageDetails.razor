@page "/packages/{Name}"
@using RustProxy.Core.Package
@inject RustProxy.Server.Services.PackageCatalog Catalog

<PageTitle>@Name / RustProxy</PageTitle>
@if (package is null){<div class="empty-state"><h1>Source not found</h1><p>The requested source is not in this registry.</p><a href="/">Back to sources</a></div>}
else
{
    <div class="breadcrumbs"><a href="/">Sources</a><span>/</span><span>@package.Name</span></div>
    <div class="workspace-head detail-head"><div><p class="eyebrow">Imported source content</p><h1>@package.Name</h1><p class="lede">@package.CargoDependencies.Count Cargo dependencies · @package.Toolchains.Count toolchains · @package.Files.Count files</p></div><a class="button button-secondary" href="/packages/@Uri.EscapeDataString(package.Name)/manifest.json">Download manifest</a></div>
    <div class="source-summary"><section class="section-block"><div class="section-heading"><h2>Cargo dependencies</h2><span>@package.CargoDependencies.Count crates</span></div>@if(package.CargoDependencies.Count == 0){<p class="section-empty">No Cargo metadata recorded.</p>}else{<div class="dependency-list">@foreach(var dependency in package.CargoDependencies){<div class="dependency-row"><span class="package-icon">CRG</span><span class="dependency-name">@dependency.Name</span><code>@dependency.Version</code></div>}</div>}</section><section class="section-block"><div class="section-heading"><h2>Toolchains</h2><span>@package.Toolchains.Count targets</span></div>@foreach(var toolchain in package.Toolchains){<div class="toolchain-row"><span class="config-badge rustup-badge">R</span><span><strong>@toolchain.Version</strong><small>@toolchain.Target</small></span></div>}</section></div>
    <section class="section-block file-section"><div class="section-heading"><h2>Stored source files</h2><span>@package.Files.Count entries</span></div><div class="file-list"><Virtualize Items="package.Files" Context="file" ItemSize="38"><div class="file-row"><span class="file-type">@(file.Path.StartsWith("cargo/") ? "CRG" : "RUP")</span><span class="file-path">@file.Path</span><span class="file-size">@FormatSize(file.Length)</span><code>@file.Sha256[..Math.Min(12, file.Sha256.Length)]…</code></div></Virtualize></div></section>
}
@code {[Parameter] public string Name { get; set; } = string.Empty; private PackageManifest? package; protected override async Task OnInitializedAsync() => package = await Catalog.FindAsync(Name); private static string FormatSize(long bytes) => bytes switch { < 1024 => $"{bytes} B", < 1024 * 1024 => $"{bytes / 1024d:0.0} KB", _ => $"{bytes / 1024d / 1024d:0.0} MB" };}
