@page "/"
@using RustProxy.Core.Package
@inject RustProxy.Server.Services.PackageCatalog Catalog

<PageTitle>RustProxy / Sources</PageTitle>

<div class="workspace-head"><div><p class="eyebrow">Offline source registry</p><h1>Available sources</h1><p class="lede">Cargo dependencies and Rust toolchains available to offline clients.</p></div><a class="button button-primary" href="import" data-enhance-nav="false">Import package</a></div>

<div class="stat-strip"><div><strong>@dependencies.Count</strong><span>Cargo crates</span></div><div><strong>@toolchains.Count</strong><span>Toolchains</span></div><div><strong>@fileCount</strong><span>Source files</span></div><div><strong>Ready</strong><span>Source status</span></div></div>

<div class="source-columns">
    <section class="section-block"><div class="section-heading"><h2>Cargo dependencies</h2><span>@dependencies.Count crates</span></div>@if (dependencies.Count == 0){<div class="empty-state compact"><h3>No Cargo dependencies</h3><p>Import a package created from a Cargo.lock project.</p></div>}else{<div class="dependency-list virtual-dependency-list"><Virtualize Items="dependencies" Context="dependency" ItemSize="52"><div class="dependency-row"><span class="package-icon">CRG</span><span class="dependency-name">@dependency.Name</span><code>@string.Join(", ", dependency.Versions)</code></div></Virtualize></div>}</section>
    <section class="section-block"><div class="section-heading"><h2>Rust toolchains</h2><span>@toolchains.Count targets</span></div>@if (toolchains.Count == 0){<div class="empty-state compact"><h3>No toolchains</h3><p>Import a package containing rustup distributions.</p></div>}else{<div class="toolchain-list">@foreach(var toolchain in toolchains){<a class="toolchain-row" href="client-config"><span class="config-badge rustup-badge">R</span><span><strong>@toolchain.Version</strong><small>@toolchain.Target</small></span><span class="row-arrow">›</span></a>}</div>}</section>
</div>

@code {
    private List<CargoDependencyGroup> dependencies = [];
    private List<RustToolchainInfo> toolchains = [];
    private int fileCount;
    private sealed record CargoDependencyGroup(string Name, List<string> Versions);
    protected override async Task OnInitializedAsync()
    {
        var overview = await Catalog.GetOverviewAsync();
        dependencies = overview.Dependencies
            .GroupBy(item => item.Name, StringComparer.OrdinalIgnoreCase)
            .Select(group => new CargoDependencyGroup(group.Key, group.Select(item => item.Version).Distinct().Order(StringComparer.Ordinal).ToList()))
            .OrderBy(item => item.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();
        toolchains = overview.Toolchains.GroupBy(item => $"{item.Version}:{item.Target}").Select(group => group.First()).OrderBy(item => item.Version).ThenBy(item => item.Target).ToList();
        fileCount = overview.FileCount;
    }
}
